# ---------------------------------------------------------------------------
# Needed at launch
# ---------------------------------------------------------------------------

# Postgres connection string. Local dev: `docker compose up -d`, then use the
# value below. In production, point at your managed Postgres (Neon, Supabase,
# RDS, etc. — hosting is deliberately not locked in).
DATABASE_URL="postgresql://sultan:sultan_dev_password@localhost:5433/sultan_nut_house?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-33"
AUTH_URL="http://localhost:3000"

# Email (Resend, behind the EmailProvider abstraction in src/integrations/email)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Sultan Nut House <orders@sultannuthouse.com>"

# Stripe (never expose the secret key to the browser)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Image storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="sultan-nut-house"
R2_PUBLIC_BASE_URL=""

# Background jobs (Inngest — Toast submission retries, Stripe reconciliation,
# inventory reservation cleanup)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CRON_SECRET="generate-a-random-secret"

# Live shipping rates + label purchase (Shippo). Falls back to the flat-rate
# ShippingMethod table if unset or if a Shippo request fails.
SHIPPING_PROVIDER="shippo"
SHIPPO_API_TOKEN=""

# Gate for real Toast order submission — keep false until partner credentials
# below exist. The pickup ordering flow works end-to-end with this off
# (submission is stubbed/logged instead of attempted).
TOAST_ORDERS_ENABLED="false"

# ---------------------------------------------------------------------------
# Needed once Toast Integration Partner approval completes
# (see https://doc.toasttab.com/doc/devguide/apiClientAccounts.html)
# ---------------------------------------------------------------------------

TOAST_CLIENT_ID=""
TOAST_CLIENT_SECRET=""
TOAST_ENVIRONMENT="sandbox"
TOAST_RESTAURANT_EXTERNAL_ID=""
# OPEN ITEM: confirm the exact sandbox/production base URL from Toast's
# partner docs once access is granted — do not guess.
TOAST_API_BASE_URL=""
# OPEN ITEM: confirm the exact webhook signature verification mechanism from
# Toast's partner docs once access is granted — do not guess.
TOAST_WEBHOOK_SIGNING_SECRET=""

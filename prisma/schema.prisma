// Sultan Nut House — database schema.
// See /Users/yusuf/.claude/plans/sultan-nut-house-iridescent-magpie.md (Section 4) for design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF_LIMITED
  MANAGER
  ADMIN
  SUPERADMIN
}

enum CategoryKind {
  MENU // cafe / pickup menu categories
  SHOP // shippable-product categories
}

/// Governs which cart(s) a product may enter. Enforced in the service layer
/// (domain/cart), never inferred from which page/route a customer used.
enum ProductFulfillmentType {
  PICKUP_ONLY
  SHIPPING_ONLY
  BOTH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ModifierSelectionType {
  SINGLE
  MULTI
}

/// Shared discriminator for Cart.type and Order.fulfillmentType. Distinct from
/// ProductFulfillmentType, which governs product *eligibility* rather than
/// which channel a given cart/order belongs to.
enum FulfillmentChannel {
  PICKUP
  SHIPPING
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

/// Superset of pickup and shipping statuses. Which subset is valid for a given
/// order is enforced by domain/orders/orderStatusMachine.ts based on
/// fulfillmentType, not by the database.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SUBMITTED_TO_TOAST
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PROCESSING
  PACKING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ToastSubmissionStatus {
  NOT_SUBMITTED
  PENDING
  SUBMITTED
  FAILED_NEEDS_RETRY
  CONFIRMED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum DiscountAppliesTo {
  ALL
  SHIPPING
  PICKUP
}

enum LocationType {
  CAFE
  WAREHOUSE
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
}

enum ToastEntityType {
  MENU_ITEM
  MODIFIER
  MODIFIER_GROUP
  DINING_OPTION
}

enum WebhookProvider {
  STRIPE
  TOAST
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 Prisma adapter shape, extended with our fields)
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  passwordHash     String?
  name             String?
  phone            String?
  role             Role      @default(CUSTOMER)
  stripeCustomerId String?   @unique
  image            String?
  /// Bumped to force re-authentication (e.g. password change, admin-forced
  /// logout, suspected compromise) since Credentials + JWT sessions can't be
  /// revoked server-side the way database sessions can. Checked in the JWT
  /// callback on every request against the DB value.
  sessionVersion   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String       @id @default(cuid())
  kind        CategoryKind
  slug        String       @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryTree")
  position    Int          @default(0)
  isVisible   Boolean      @default(true)
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind, isVisible, position])
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String?
  isCurated   Boolean             @default(true)
  isVisible   Boolean             @default(true)
  position    Int                 @default(0)
  products    CollectionProduct[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
}

model Product {
  id                  String                 @id @default(cuid())
  slug                String                 @unique
  name                String
  description         String?
  fulfillmentType     ProductFulfillmentType
  status              ProductStatus          @default(DRAFT)
  categoryId          String?
  category            Category?              @relation(fields: [categoryId], references: [id])
  allergenInfo        String?
  ingredients         String?
  nutritionInfo       Json?
  storageInstructions String?
  seoTitle            String?
  seoDescription      String?
  position            Int                    @default(0)
  variants            ProductVariant[]
  images              ProductImage[]
  modifierGroups      ProductModifierGroup[]
  collections         CollectionProduct[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([fulfillmentType, status])
  @@index([categoryId])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String   @unique
  name                String
  priceCents          Int
  compareAtPriceCents Int?
  weightGrams         Int?
  /// Free-form attributes such as { "size": "Large", "flavor": "Pistachio" }
  attributes          Json?
  isDefault           Boolean  @default(false)
  isAvailable         Boolean  @default(true)
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inventory             Inventory[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Reusable modifier system (drinks, sandwiches, pastries, and beyond — never
// hardcoded per-component)
// ---------------------------------------------------------------------------

model ModifierGroup {
  id            String                @id @default(cuid())
  name          String
  selectionType ModifierSelectionType
  minSelect     Int                   @default(0)
  maxSelect     Int                   @default(1)
  required      Boolean               @default(false)
  position      Int                   @default(0)
  options       ModifierOption[]
  products      ProductModifierGroup[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model ModifierOption {
  id                 String   @id @default(cuid())
  modifierGroupId    String
  modifierGroup      ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name               String
  priceDeltaCents    Int      @default(0)
  isDefault          Boolean  @default(false)
  isAvailable        Boolean  @default(true)
  position           Int      @default(0)
  cartItemModifiers  CartItemModifier[]
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
}

model ProductModifierGroup {
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  position        Int           @default(0)

  @@id([productId, modifierGroupId])
}

// ---------------------------------------------------------------------------
// Cart — one table, `type` discriminator; a cart is never mixed pickup+shipping
// ---------------------------------------------------------------------------

model Cart {
  id                String             @id @default(cuid())
  type              FulfillmentChannel
  status            CartStatus         @default(ACTIVE)
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestToken        String?            @unique
  contactEmail      String?
  contactPhone      String?
  pickupTime        DateTime?
  shippingAddressId String?
  shippingAddress   Address?           @relation(fields: [shippingAddressId], references: [id])
  items             CartItem[]
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([guestToken])
}

model CartItem {
  id                     String                @id @default(cuid())
  cartId                 String
  cart                   Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId       String
  productVariant         ProductVariant        @relation(fields: [productVariantId], references: [id])
  quantity               Int
  unitPriceCentsSnapshot Int
  notes                  String?
  modifiers              CartItemModifier[]
  reservation            InventoryReservation?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([cartId])
}

model CartItemModifier {
  id                      String         @id @default(cuid())
  cartItemId              String
  cartItem                CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierOptionId        String
  modifierOption          ModifierOption @relation(fields: [modifierOptionId], references: [id])
  priceDeltaCentsSnapshot Int

  @@index([cartItemId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                      String                 @id @default(cuid())
  orderNumber             String                 @unique
  fulfillmentType         FulfillmentChannel
  status                  OrderStatus            @default(PENDING_PAYMENT)
  userId                  String?
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactEmail            String
  contactPhone            String?
  pickupTime              DateTime?
  shippingAddressId       String?
  shippingAddress         Address?               @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  shippingMethodId        String?
  shippingMethod          ShippingMethod?        @relation(fields: [shippingMethodId], references: [id])
  /// Set when a live carrier rate (e.g. Shippo) was quoted at checkout,
  /// rather than an admin-configured flat ShippingMethod.
  shippingServiceName     String?
  shippoRateId            String?
  trackingNumber          String?
  trackingCarrier         String?
  trackingUrl             String?
  labelUrl                String?
  toastOrderGuid          String?
  toastSubmissionStatus   ToastSubmissionStatus  @default(NOT_SUBMITTED)
  toastRetryCount         Int                    @default(0)
  toastLastError          String?
  needsManualReview       Boolean                @default(false)
  subtotalCents           Int
  taxCents                Int                    @default(0)
  tipCents                Int                    @default(0)
  shippingCents           Int                    @default(0)
  discountCents           Int                    @default(0)
  totalCents              Int
  stripePaymentIntentId   String?                @unique
  stripeCheckoutSessionId String?                @unique
  items                   OrderItem[]
  payments                Payment[]
  discounts               OrderDiscount[]
  placedAt                DateTime?
  notes                   String?
  /// Plain reference (no FK) to the Cart this order was placed from, so the
  /// Stripe webhook — which has no access to the customer's cookies — can
  /// mark that cart CONVERTED once payment is confirmed.
  sourceCartId            String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([userId])
  @@index([fulfillmentType, status])
  @@index([contactEmail])
  @@index([toastSubmissionStatus, needsManualReview])
}

model OrderItem {
  id                     String              @id @default(cuid())
  orderId                String
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId       String
  productVariant         ProductVariant      @relation(fields: [productVariantId], references: [id])
  productNameSnapshot    String
  variantNameSnapshot    String
  quantity               Int
  unitPriceCentsSnapshot Int
  notes                  String?
  modifiers              OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id                         String          @id @default(cuid())
  orderItemId                String
  orderItem                  OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId           String?
  modifierOption              ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)
  modifierOptionNameSnapshot String
  priceDeltaCentsSnapshot    Int

  @@index([orderItemId])
}

model Payment {
  id                    String          @id @default(cuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider @default(STRIPE)
  stripePaymentIntentId String?
  stripeChargeId        String?
  amountCents           Int
  status                PaymentStatus
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------

model Discount {
  id            String            @id @default(cuid())
  code          String            @unique
  type          DiscountType
  /// Percentage points (0-100) for PERCENTAGE, cents for FIXED; ignored for FREE_SHIPPING
  value         Int
  minOrderCents Int?
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usageCount    Int               @default(0)
  appliesTo     DiscountAppliesTo @default(ALL)
  isActive      Boolean           @default(true)
  orders        OrderDiscount[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model OrderDiscount {
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountId         String
  discount           Discount @relation(fields: [discountId], references: [id])
  amountAppliedCents Int

  @@id([orderId, discountId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Location {
  id           String       @id @default(cuid())
  name         String
  type         LocationType
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String       @default("US")
  phone        String?
  latitude     Float?
  longitude    Float?
  isActive     Boolean      @default(true)
  inventory    Inventory[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Inventory {
  id                String         @id @default(cuid())
  productVariantId  String
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantityOnHand    Int            @default(0)
  lowStockThreshold Int            @default(0)
  trackInventory    Boolean        @default(true)
  updatedAt         DateTime       @updatedAt

  @@unique([productVariantId, locationId])
}

/// Prevents overselling shippable goods during checkout: available-to-sell =
/// quantityOnHand - Σ ACTIVE reservations. An Inngest cron releases expired
/// ACTIVE reservations.
model InventoryReservation {
  id               String             @id @default(cuid())
  cartItemId       String             @unique
  cartItem         CartItem           @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant     @relation(fields: [productVariantId], references: [id])
  quantity         Int
  status           ReservationStatus  @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime           @default(now())

  @@index([productVariantId, status])
  @@index([expiresAt, status])
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

model Address {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName    String
  line1            String
  line2            String?
  city             String
  state            String
  postalCode       String
  country          String   @default("US")
  phone            String?
  isDefault        Boolean  @default(false)
  carts            Cart[]
  ordersAsShipping Order[]  @relation("OrderShippingAddress")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

model ShippingMethod {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  carrier          String?
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  flatRateCents    Int
  isActive         Boolean  @default(true)
  position         Int      @default(0)
  orders           Order[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Toast integration — one-way sync (Toast -> our mapping table). Our internal
// IDs are never Toast-dependent; see /src/integrations/toast.
// ---------------------------------------------------------------------------

model ToastMapping {
  id           String          @id @default(cuid())
  entityType   ToastEntityType
  internalId   String
  toastGuid    String
  lastSyncedAt DateTime        @default(now())

  @@unique([entityType, internalId])
  @@index([toastGuid])
}

model ToastSyncLog {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  itemsUpdated Int       @default(0)
  error        String?
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// Idempotency store for both Stripe and Toast webhooks.
model WebhookEvent {
  id         String          @id @default(cuid())
  provider   WebhookProvider
  eventId    String
  type       String
  status     String          @default("RECEIVED")
  receivedAt DateTime        @default(now())

  @@unique([provider, eventId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}
